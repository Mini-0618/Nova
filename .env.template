# Codex-Local Environment Configuration Template
# Copy to .env and fill in your values

# ─── Provider Selection ────────────────────────────────────────────────────
# Options: deepseek | xiaomi | ollama | anthropic
CODEX_PROVIDER=deepseek

# ─── API Keys ──────────────────────────────────────────────────────────────
# DeepSeek
DEEPSEEK_API_KEY=

# XiaoMi MIMO
CODEX_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# ─── Model Selection ───────────────────────────────────────────────────────
# DeepSeek: deepseek-chat | deepseek-coder | deepseek-reasoner
# XiaoMi: mimo-v2.5
# Ollama: llama3 | qwen2.5 | codellama (must be running locally)
# Anthropic: claude-opus-4-8 | claude-sonnet-4-6 | claude-haiku-4-5
CODEX_MODEL=deepseek-chat

# ─── Paths ─────────────────────────────────────────────────────────────────
CODEX_WORKSPACE=D:\
CODEX_SANDBOX_ROOT=D:/codex-local/sandbox
CODEX_DATA=D:/codex-local/data
CODEX_LOGS=D:/codex-local/logs

# ─── Bridge Server ─────────────────────────────────────────────────────────
CODEX_BRIDGE_PORT=8787
CODEX_BRIDGE_URL=http://127.0.0.1:8787/v1/responses

# ─── Shell ─────────────────────────────────────────────────────────────────
# bash | cmd.exe | powershell
CODEX_SHELL=bash

# ─── Chrome (for browser control) ─────────────────────────────────────────
CODEX_CHROME_PORT=9222

# ─── Ollama (for local models) ─────────────────────────────────────────────
# ollama list to see available models